# Copy to .env and fill in real values. Never commit the real .env file.

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

DATABASE_URL=jdbc:postgresql://db:5432/expensetracker
DATABASE_USERNAME=expensetracker
DATABASE_PASSWORD=replace-with-a-strong-password

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: leave SMTP_HOST blank to have password-reset links logged instead of emailed (fine for dev/demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@spendwise.app
FRONTEND_RESET_URL=http://localhost:3000/reset-password

SPRING_PROFILES_ACTIVE=prod

FRONTEND_VERIFY_URL=http://localhost:3000/verify-email

# Comma-separated emails to promote to admin on startup (account must already exist — register first)
ADMIN_EMAILS=

# "memory" (default, single instance) or "redis" (multi-instance; needs REDIS_HOST reachable)
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX_PER_MINUTE=20
REDIS_HOST=localhost
REDIS_PORT=6379
